NEXT_PUBLIC_APP_URL=https://your-vercel-or-ngrok-url.example
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567
# Optionnel : si défini, les routes /api/demo/* exigent l'en-tête x-demo-secret
DEMO_SECRET=

# Stripe (mode test). Clé et secret de webhook : voir docs/mvp-testing.md (stripe listen --print-secret)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx

# Optionnel : adresse du front (retours Checkout / onboarding), défaut http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Optionnel : true = bloque les nouveaux signalements tant que l'abonnement n'est pas actif
REQUIRE_SUBSCRIPTION=false
# Démo : true = autorise à valider/payer un shift avant sa fin (les shifts de démo sont dans le futur)
ALLOW_EARLY_PAYOUT=false
